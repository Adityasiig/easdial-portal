# Copy to .env. NEVER commit .env.
NODE_ENV=development
PORT=4000

# Auth (this app's own carrier login)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1h

# Database (optional in mock mode; required once you persist users)
DATABASE_URL=postgres://easdial:easdial@localhost:5432/easdial_portal

# ---- Peeredge data source ----
# "mock" (default, no creds) or "rest" (live PeerEdge relationship API)
PEEREDGE_SOURCE=mock
PEEREDGE_BASE_URL=https://api-dialphone.peeredge.com
PEEREDGE_ORIGIN=https://carrier-dialphone.peeredge.com

# PeerEdge uses a session COOKIE (there is no API key). Two modes:
#   cookie -> paste a current session cookie (expires; good for testing)
#   login  -> backend logs in with the credentials below to obtain the cookie
PEEREDGE_AUTH_MODE=cookie
PEEREDGE_SESSION_COOKIE=
# Only for PEEREDGE_AUTH_MODE=login (confirm the login URL/payload from a capture):
PEEREDGE_LOGIN_URL=
PEEREDGE_EMAIL=
PEEREDGE_PASSWORD=

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Where password-set links point (branded email)
PORTAL_BASE_URL=http://localhost:5173
