# Copy to .env. NEVER commit .env.
NODE_ENV=development
PORT=4000

# Session signing
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=12h

# EasDial admin account (seeds the first admin login)
EASDIAL_ADMIN_EMAIL=admin@easdial.com
EASDIAL_ADMIN_PASSWORD=change_this_admin_password

# ---- Data source ----
# "mock" (synthetic, no creds) or "rest" (live DialPhone admin API)
PEEREDGE_SOURCE=mock
PEEREDGE_BASE_URL=https://api-dialphone.peeredge.com
PEEREDGE_SLUG=dialphone
PEEREDGE_BRAND_PREFIX=ED

# Switch-admin SERVICE login (one account reads the whole switch).
# Only needed when PEEREDGE_SOURCE=rest.
PEEREDGE_ADMIN_EMAIL=
PEEREDGE_ADMIN_PASSWORD=
PEEREDGE_ADMIN_LOGIN_PATH=/api/v2/login

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173
