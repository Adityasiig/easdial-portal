# Copy to .env. NEVER commit .env.
NODE_ENV=development
PORT=4000

# Auth (this app's own carrier login)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1h

# Database (optional in mock mode; required once you persist users)
DATABASE_URL=postgres://easdial:easdial@localhost:5432/easdial_portal

# ---- Peeredge data source ----
# "mock" (default, no creds) or "rest" (live PeerEdge API).
# Pass-through auth: each user signs in with their OWN Peeredge carrier
# credentials, so NO Peeredge login is stored here — only where to reach it.
PEEREDGE_SOURCE=mock
PEEREDGE_BASE_URL=https://api-dialphone.peeredge.com
PEEREDGE_SLUG=dialphone
# Carrier login path (bearer token, per the 46 Labs reference). Adjust if needed.
PEEREDGE_LOGIN_PATH=/api/v2/relationship/auth/login

# First-user seeding (create a login on a fresh deploy — store is in-memory).
# Always on in dev. In production, set SEED_DEMO=true to enable it.
SEED_DEMO=false
SEED_DEMO_EMAIL=carrier@easdial.com
SEED_DEMO_PASSWORD=change_this_in_production
SEED_DEMO_RELATIONSHIP=REL-1001

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Where password-set links point (branded email)
PORTAL_BASE_URL=http://localhost:5173
